{
  "name": "oh-my-co-work",
  "version": "4.7.0",
  "private": true,
  "type": "module",
  "description": "群聊式多智能体协同台 MVP",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:desktop": "electron .",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "seed": "npm run seed -w server",
    "start": "node start.mjs",
    "start:server": "npm run start -w server",
    "backup": "node scripts/backup.mjs",
    "pack": "node scripts/pack-release.mjs",
    "pack:desktop-win": "node scripts/pack-release.mjs --desktop",
    "validate:packages": "node scripts/validate-release-packages.mjs",
    "build": "npm run build -w web",
    "lint": "eslint .",
    "test": "npm run test -w server",
    "test:web": "node --test web/test/*.test.mjs",
    "test:electron": "node --test electron/test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.11.0",
    "playwright": "^1.61.1"
  }
}
